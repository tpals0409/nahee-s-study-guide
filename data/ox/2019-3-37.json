[{"c": 0, "text": "금성의 자전 주기는 약 243일이다.", "o": true, "note": "금성은 약 243일에 한 번 자전합니다.", "kind": "concept"}, {"c": 0, "text": "금성 대기의 주성분은 이산화탄소이다.", "o": true, "note": "금성의 대기는 주로 이산화탄소로 되어 있습니다.", "kind": "concept"}, {"c": 0, "text": "화성의 자전 주기는 약 59일이다.", "o": false, "note": "'약 59일'이 틀렸습니다. 화성의 자전 주기는 약 24.6시간이고, 약 59일인 것은 수성입니다.", "kind": "concept"}, {"c": 0, "text": "목성의 자전 주기는 243일보다 길다.", "o": false, "note": "'243일보다 길다'가 틀렸습니다. 목성의 자전 주기는 약 9.9시간으로 243일보다 훨씬 짧습니다.", "kind": "concept"}]